# ============================================================
# MIRA Backend - environment configuration
# Copy to .env and adjust for your environment.
# ============================================================

# --- App ---
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/material_master

# --- Milvus (vector database) ---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=material_embeddings
EMBEDDING_DIM=1536

# --- Qwen-1B-Embedding ---
# auto   = use the Qwen model if installed + available, else deterministic fallback
# qwen   = force the Qwen model (fails fast if unavailable)
# hashing= force the deterministic fallback (no torch/transformers needed)
EMBEDDING_BACKEND=auto
QWEN_MODEL_PATH=models/qwen_quantized
QWEN_BATCH_SIZE=32

# --- MIRA matching parameters (frozen formula shape) ---
HIGH_CONFIDENCE_THRESHOLD=0.85
DIFFERENT_THRESHOLD=0.45
VECTOR_TOP_K=100
WEIGHT_TEXT=0.20
WEIGHT_SEMANTIC=0.20
WEIGHT_SPECIFICATION=0.35
WEIGHT_MATERIAL_GRADE=0.15
WEIGHT_OTHER_ATTRIBUTES=0.10

# --- ROI calculator assumptions ---
BULK_DISCOUNT_RATE=0.08
CARRYING_COST_RATE=0.20
SAFETY_STOCK_DAYS=30

# --- SAP integration ---
# true  = simulate pulls/pushes with deterministic sample data (demo mode)
# false = live RFC calls (requires pyrfc + SAP NWRDK installed)
SAP_SIMULATE=true

# --- Seed data (created on first startup) ---
SEED_ADMIN_EMAIL=admin@mira.gov.in
SEED_ADMIN_PASSWORD=Admin@123

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

